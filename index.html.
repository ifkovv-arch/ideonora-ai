
<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101713">
<title>IDEONORA AI — Твоя ідея, твоя музика</title>
<style>
:root{--bg:#101713;--side:#18221c;--panel:#202d24;--card:#26372b;--accent:#b8ed62;--text:#f3f7ef;--muted:#aab8aa}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,sans-serif}
button,input,textarea,select{font:inherit}
button{cursor:pointer;border:0;border-radius:10px;padding:11px 15px;background:var(--accent);color:#172014;font-weight:bold}
.layout{min-height:100vh;display:flex}
.sidebar{width:230px;background:var(--side);padding:20px 13px;flex-shrink:0;min-height:100vh;border-right:1px solid #ffffff12}
.logo{font-size:21px;font-weight:900;color:var(--accent);padding:8px 10px}
.tag{font-size:12px;color:var(--muted);padding:0 10px 22px}
.nav button{display:block;width:100%;text-align:left;margin:4px 0;background:transparent;color:var(--muted);font-weight:500}
.nav button.active,.nav button:hover{background:var(--card);color:var(--accent)}
main{flex:1;min-width:0;padding:22px;max-width:1100px}
.top{display:flex;align-items:center;gap:12px;margin-bottom:22px}
.menu{display:none}
.page{display:none}
.page.active{display:block}
h1{font-size:28px;margin:8px 0}
h2{font-size:20px}
p{color:var(--muted);line-height:1.5}
.panel{background:var(--panel);border:1px solid #ffffff12;border-radius:15px;padding:18px;margin:12px 0}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}
.tile{background:var(--card);border-radius:13px;padding:16px;cursor:pointer}
.tile:hover{outline:1px solid var(--accent)}
.tile strong{display:block;margin-bottom:7px}
label{display:block;color:var(--muted);font-size:13px;margin:13px 0 6px}
input,textarea,select{width:100%;padding:12px;background:var(--bg);border:1px solid #ffffff25;border-radius:9px;color:var(--text)}
textarea{min-height:110px;resize:vertical}
.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px}
.secondary{background:var(--card);color:var(--text)}
.small{font-size:12px;color:var(--muted)}
.project{padding:12px;background:var(--card);border-radius:10px;margin:8px 0}
@media(max-width:700px){
.sidebar{position:fixed;z-index:10;left:-250px;top:0;bottom:0;transition:.2s;box-shadow:10px 0 30px #0008}
.sidebar.open{left:0}
.menu{display:block}
main{padding:14px}
h1{font-size:24px}
}
</style>
</head>
<body>
<div class="layout">
<aside class="sidebar" id="sidebar">
<div class="logo">IDEONORA AI</div>
<div class="tag">Твоя ідея — твоя музика</div>
<nav class="nav">
<button class="active" onclick="showPage('home',this)">⌂ Головна</button>
<button onclick="showPage('create',this)">♫ Створити пісню</button>
<button onclick="showPage('author',this)">✎ AI Автор</button>
<button onclick="showPage('vocal',this)">🎙 Вокал</button>
<button onclick="showPage('master',this)">◉ Мастеринг</button>
<button onclick="showPage('cover',this)">▧ Обкладинки</button>
<button onclick="showPage('video',this)">▶ Музичне відео</button>
<button onclick="showPage('library',this)">▤ Моя музика</button>
<button onclick="showPage('settings',this)">⚙ Налаштування</button>
</nav>
</aside>
<main>
<div class="top">
<button class="menu" onclick="toggleMenu()">☰</button>
<span class="small">ТВОРЧА СТУДІЯ</span>
</div>

<section id="home" class="page active">
<div class="panel">
<p>ТВОЯ МУЗИЧНА ПЛАТФОРМА</p>
<h1>Створи музику своєї мрії</h1>
<p>Від першої ідеї до готового музичного проєкту — в одному місці.</p>
<button onclick="showPage('create')">＋ Почати створення</button>
</div>
<h2>Інструменти</h2>
<div class="grid">
<div class="tile" onclick="showPage('create')"><strong>♫ Створити пісню</strong><span class="small">Стиль, настрій, голос та ідея</span></div>
<div class="tile" onclick="showPage('author')"><strong>✎ AI Автор</strong><span class="small">Тексти, рими та приспіви</span></div>
<div class="tile" onclick="showPage('vocal')"><strong>🎙 Вокал</strong><span class="small">Робота з вокалом</span></div>
<div class="tile" onclick="showPage('master')"><strong>◉ Мастеринг</strong><span class="small">Підготовка звучання</span></div>
<div class="tile" onclick="showPage('cover')"><strong>▧ Обкладинка</strong><span class="small">Візуальний стиль релізу</span></div>
<div class="tile" onclick="showPage('video')"><strong>▶ Відео</strong><span class="small">Ідеї та сценарії кліпів</span></div>
</div>
</section>

<section id="create" class="page">
<h1>Створити пісню</h1>
<div class="panel">
<label>Назва або ідея пісні</label><input id="song" placeholder="Про що буде твоя пісня?">
<label>Музичний стиль</label>
<select id="style"><option>Українська естрада</option><option>80s Synthpop</option><option>90s Eurodance</option><option>2000s Pop</option><option>Сучасний Pop</option><option>Весільна естрада</option></select>
<label>Мова</label><select id="language"><option>Українська</option><option>English</option><option>Čeština</option></select>
<label>Вокал</label><select id="voice"><option>Чоловічий</option><option>Жіночий</option><option>Дует</option><option>Інструментал</option></select>
<label>Настрій</label><select id="mood"><option>Романтичний</option><option>Енергійний</option><option>Меланхолійний</option><option>Святковий</option></select>
<label>Додаткові побажання</label><textarea id="details" placeholder="Інструменти, темп, звучання..."></textarea>
<div class="actions"><button onclick="saveSong()">Зберегти проєкт</button></div>
<p class="small">Генерація аудіо потребуватиме підключення окремого музичного AI-сервісу.</p>
</div>
</section>

<section id="author" class="page">
<h1>AI Автор</h1>
<div class="panel">
<p>Створи або вдоскональ власний текст пісні.</p>
<label>Тема та задум</label><textarea id="lyrics" placeholder="Опиши історію, емоцію або головну думку пісні..."></textarea>
<label>Нотатки автора</label><textarea id="notes" placeholder="Рими, приспів, побажання до тексту..."></textarea>
<button onclick="saveText()">Зберегти текст</button>
</div>
</section>

<section id="vocal" class="page">
<h1>Вокальна студія</h1>
<div class="panel">
<h2>Мій голос</h2>
<p>Місце для створення приватного голосового профілю на основі власного запису.</p>
<label>Мої нотатки до вокалу</label><textarea id="vocalnotes" placeholder="Вимова, інтонація, тембр, виправлення..."></textarea>
<p class="small">Запис і генерація голосу потребують окремого безпечного сервісу та підтвердження прав на голос.</p>
<button onclick="saveField('vocalnotes','Нотатки вокалу')">Зберегти</button>
</div>
</section>

<section id="master" class="page">
<h1>Мастеринг</h1>
<div class="panel">
<p>Підготовка треку до фінального звучання.</p>
<label>Назва аудіофайлу або проєкту</label><input id="masterfile" placeholder="Назва треку">
<label>Побажання до звучання</label><textarea id="masternotes" placeholder="Гучність, бас, чистота вокалу..."></textarea>
<button onclick="saveField('masternotes','Нотатки мастерингу')">Зберегти</button>
<p class="small">Обробка аудіо буде доступна після підключення аудіосервісу.</p>
</div>
</section>

<section id="cover" class="page">
<h1>Обкладинки</h1>
<div class="panel">
<label>Назва релізу</label><input id="covername" placeholder="Назва пісні">
<label>Опис задуму</label><textarea id="coveridea" placeholder="Стиль, кольори, сюжет, формат 3000×3000 або 16:9 чи 9:16..."></textarea>
<button onclick="saveField('coveridea','Задум обкладинки')">Зберегти задум</button>
</div>
</section>

<section id="video" class="page">
<h1>Музичне відео</h1>
<div class="panel">
<label>Назва пісні</label><input id="videoname" placeholder="Назва треку">
<label>Сценарій та ідеї сцен</label><textarea id="videoidea" placeholder="Опиши відео, кадри, рух камери, текст і гачок..."></textarea>
<label>Формат</label><select id="videoformat"><option>Shorts 9:16</option><option>YouTube 16:9</option><option>Квадрат 1:1</option></select>
<button onclick="saveField('videoidea','Сценарій відео')">Зберегти</button>
</div>
</section>

<section id="library" class="page">
<h1>Моя музика</h1>
<div class="panel">
<p>Твої збережені проєкти та нотатки.</p>
<div id="projects"></div>
<div class="actions"><button class="secondary" onclick="exportData()">Експорт даних</button><button class="secondary" onclick="clearData()">Очистити проєкти</button></div>
</div>
</section>

<section id="settings" class="page">
<h1>Налаштування</h1>
<div class="panel">
<label>Мова інтерфейсу</label><select><option>Українська</option><option>English — скоро</option><option>Čeština — скоро</option></select>
<label>Оформлення</label><select id="theme" onchange="setTheme(this.value)"><option value="green">Зелений преміум</option><option value="blue">Синій</option><option value="purple">Фіолетовий</option></select>
<p class="small">IDEONORA AI — твоя творча студія.</p>
</div>
</section>
</main>
</div>
<script>
function showPage(id,btn){
document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
document.getElementById(id).classList.add('active');
document.querySelectorAll('.nav button').forEach(b=>b.classList.remove('active'));
if(btn)btn.classList.add('active');
document.getElementById('sidebar').classList.remove('open');
if(id==='library')renderProjects();
}
function toggleMenu(){document.getElementById('sidebar').classList.toggle('open')}
function getProjects(){try{return JSON.parse(localStorage.getItem('ideonora-projects')||'[]')}catch(e){return []}}
function addProject(title,content){
let a=getProjects();a.unshift({title,content,date:new Date().toLocaleString('uk-UA')});
localStorage.setItem('ideonora-projects',JSON.stringify(a));alert('Проєкт збережено!');
}
function saveSong(){
let title=document.getElementById('song').value.trim()||'Нова пісня';
let content='Стиль: '+style.value+'; Мова: '+language.value+'; Вокал: '+voice.value+'; Настрій: '+mood.value+'; Побажання: '+details.value;
addProject(title,content);
}
function saveText(){addProject('Текст пісні',lyrics.value+'\n'+notes.value)}
function saveField(id,title){addProject(title,document.getElementById(id).value)}
function renderProjects(){
let a=getProjects();let box=document.getElementById('projects');
box.innerHTML=a.length?a.map(x=>'<div class="project"><strong>'+escapeHTML(x.title)+'</strong><p>'+escapeHTML(x.content)+'</p><span class="small">'+escapeHTML(x.date)+'</span></div>').join(''):'<p>Поки що проєктів немає.</p>';
}
function escapeHTML(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function exportData(){
let blob=new Blob([JSON.stringify(getProjects(),null,2)],{type:'application/json'});
let a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='ideonora-projects.json';a.click();URL.revokeObjectURL(a.href);
}
function clearData(){if(confirm('Очистити всі збережені проєкти?')){localStorage.removeItem('ideonora-projects');renderProjects()}}
function setTheme(t){
let r=document.documentElement;
if(t==='blue'){r.style.setProperty('--accent','#68d9ed');r.style.setProperty('--side','#14212b');r.style.setProperty('--panel','#1d303b');r.style.setProperty('--card','#294453')}
else if(t==='purple'){r.style.setProperty('--accent','#c7a0ff');r.style.setProperty('--side','#21192c');r.style.setProperty('--panel','#30243d');r.style.setProperty('--card','#403052')}
else{r.style.setProperty('--accent','#b8ed62');r.style.setProperty('--side','#18221c');r.style.setProperty('--panel','#202d24');r.style.setProperty('--card','#26372b')}
}
renderProjects();
</script>
</body>
</html>
