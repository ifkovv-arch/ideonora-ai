<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090b14">
<meta name="description" content="IDEONORA AI — твоя ідея, твоя музика.">
<title>IDEONORA AI — Твоя ідея, твоя музика</title>
<style>
:root{
--bg:#090b14;--panel:#151b2d;--panel2:#101525;
--text:#f4f5ff;--muted:#969db5;--line:#252c42;
--accent:#9c7bff;--cyan:#54d9e8;--green:#7ce0b0;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
margin:0;background:radial-gradient(ellipse at 50% -20%,#24204a 0%,var(--bg) 55%);
color:var(--text);font-family:Inter,system-ui,Arial,sans-serif;
min-height:100vh
}
button,select,input,textarea{font:inherit}
button{cursor:pointer}
header{
position:sticky;top:0;z-index:10;background:#090b14ed;
border-bottom:1px solid var(--line);backdrop-filter:blur(12px)
}
.nav{
max-width:1150px;margin:auto;padding:14px 20px;
display:flex;align-items:center;justify-content:space-between;gap:12px
}
.brand{display:flex;align-items:center;gap:10px;font-weight:900;letter-spacing:1px}
.logo{
width:38px;height:38px;border-radius:12px;display:grid;place-items:center;
font-size:21px;background:linear-gradient(135deg,#a78bfa,#36c6d9)
}
.brand span{color:#b5a0ff}
.nav-right{display:flex;align-items:center;gap:10px}
select,.field,textarea{
background:#0c1020;color:var(--text);border:1px solid var(--line);
border-radius:11px;padding:12px;width:100%;outline:none
}
#language{width:auto;max-width:125px}
button{
border:0;border-radius:11px;padding:12px 17px;
background:var(--panel);color:var(--text);font-weight:700
}
button:hover{filter:brightness(1.15)}
.primary{
background:linear-gradient(110deg,#8c6bfa,#4c9de9);
box-shadow:0 5px 25px #7959ee35
}
.ghost{border:1px solid var(--line);background:transparent}
.container{max-width:1150px;margin:auto;padding:25px 20px 70px}
.hero{text-align:center;padding:65px 12px 45px}
.eyebrow{color:var(--cyan);font-size:12px;font-weight:800;letter-spacing:3px;text-transform:uppercase}
h1{font-size:clamp(38px,7vw,68px);line-height:1.05;margin:18px 0}
.gradient{
background:linear-gradient(100deg,#c4aaff,#62dce8);
-webkit-background-clip:text;background-clip:text;color:transparent
}
.hero p{color:var(--muted);font-size:17px;line-height:1.7;max-width:650px;margin:18px auto 25px}
.hero-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}
.section-title{font-size:26px;margin:40px 0 8px}
.sub{color:var(--muted);margin:0 0 20px;line-height:1.6}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}
.card{
background:linear-gradient(145deg,#151b2d,#101525);
border:1px solid var(--line);border-radius:18px;padding:21px;
min-width:0;transition:.2s
}
.card:hover{border-color:#7560bb;transform:translateY(-2px)}
.card-icon{
width:45px;height:45px;border-radius:13px;display:grid;place-items:center;
font-size:22px;background:#8d75ff20;margin-bottom:15px
}
.card h3{margin:8px 0}
.card p{color:var(--muted);font-size:14px;line-height:1.6}
.card button{margin-top:8px}
.studio{
margin-top:45px;padding:25px;background:#111728;
border:1px solid var(--line);border-radius:20px
}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}
label{display:block;font-size:13px;color:var(--muted);margin-bottom:7px}
textarea{min-height:110px;resize:vertical}
.full{grid-column:1/-1}
.project{
display:flex;justify-content:space-between;align-items:center;gap:12px;
padding:15px;margin-top:10px;background:#0c1120;
border:1px solid var(--line);border-radius:12px
}
.project p{margin:5px 0 0;color:var(--muted);font-size:13px}
.delete{background:#3a1d2a;color:#ffb3c0}
.notice{
margin-top:18px;padding:14px;border-radius:12px;
background:#1c2035;color:#c4c8df;font-size:13px;line-height:1.6
}
footer{text-align:center;color:var(--muted);padding:35px 15px;font-size:13px}
@media(max-width:750px){
.grid{grid-template-columns:1fr 1fr}
}
@media(max-width:520px){
.grid,.form-grid{grid-template-columns:1fr}
.full{grid-column:auto}
.hero{padding-top:45px}
.nav{padding:12px}
.brand{font-size:13px}
.project{align-items:flex-start}
}
</style>
</head>
<body>
<header>
<div class="nav">
<div class="brand"><div class="logo">✦</div><div>IDEONORA <span>AI</span></div></div>
<div class="nav-right">
<select id="language" aria-label="Language">
<option value="uk">Українська</option>
<option value="en">English</option>
<option value="cs">Čeština</option>
</select>
</div>
</div>
</header>

<main class="container">
<section class="hero">
