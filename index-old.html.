let currentLanguage="uk";
function t(key){
return translations[currentLanguage][key]||translations.uk[key]||key;
}
function setLanguage(lang){
if(!translations[lang])lang="uk";
currentLanguage=lang;
document.documentElement.lang=lang;
document.querySelectorAll("[data-i18n]").forEach(el=>{
const key=el.dataset.i18n;
if(translations[lang][key])el.textContent=translations[lang][key];
});
try{localStorage.setItem("ideonora-language",lang)}catch(e){}
document.getElementById("language").value=lang;
renderProjects();
}
function getProjects(){
try{return JSON.parse(localStorage.getItem("ideonora-projects")||"[]")}
catch(e){return []}
}
function renderProjects(){
const list=document.getElementById("projectList");
const projects=getProjects();
list.innerHTML="";
if(!projects.length){
const empty=document.createElement("p");
empty.className="sub";
empty.textContent=t("empty");
list.appendChild(empty);
return;
}
projects.forEach(project=>{
const card=document.createElement("div");
card.className="project";
const info=document.createElement("div");
const title=document.createElement("strong");
title.textContent=project.name;
const detail=document.createElement("p");
detail.textContent=[project.genre,project.era,project.voice,project.language].filter(Boolean).join(" • ");
info.append(title,detail);
const del=document.createElement("button");
del.className="delete";
del.textContent=t("delete");
del.addEventListener("click",()=>deleteProject(project.id));
card.append(info,del);
list.appendChild(card);
});
}
function saveProject(){
const name=document.getElementById("projectName").value.trim();
const idea=document.getElementById("idea").value.trim();
if(!name){alert(t("needName"));return}
const project={
id:Date.now(),
name:name,
idea:idea,
genre:document.getElementById("genre").value,
era:document.getElementById("era").value,
voice:document.getElementById("voice").value,
language:document.getElementById("languageSong").value,
date:new Date().toLocaleDateString()
};
const projects=getProjects();
projects.unshift(project);
try{
localStorage.setItem("ideonora-projects",JSON.stringify(projects));
document.getElementById("projectName").value="";
document.getElementById("idea").value="";
renderProjects();
alert(t("saved"));
}catch(e){
alert("Could not save this project in your browser.");
}
}
function deleteProject(id){
const projects=getProjects().filter(p=>p.id!==id);
try{
localStorage.setItem("ideonora-projects",JSON.stringify(projects));
renderProjects();
}catch(e){}
}
function goTo(id){
const target=document.getElementById(id);
if(target)target.scrollIntoView({behavior:"smooth",block:"start"});
}
document.addEventListener("DOMContentLoaded",()=>{
let savedLanguage="uk";
try{savedLanguage=localStorage.getItem("ideonora-language")||"uk"}catch(e){}
document.getElementById("language").addEventListener("change",e=>setLanguage(e.target.value));
document.getElementById("startBtn").addEventListener("click",()=>goTo("studio"));
document.getElementById("exploreBtn").addEventListener("click",()=>goTo("features"));
document.getElementById("saveBtn").addEventListener("click",saveProject);
document.querySelectorAll(".module").forEach(button=>{
button.addEventListener("click",()=>{
if(button.dataset.module==="song")goTo("studio");
else alert(t("moduleDemo"));
});
});
setLanguage(savedLanguage);
});
